{
  "mcpServers": {
    "playwright": { "type": "stdio", "command": "npx", "args": ["@playwright/mcp@latest"] },
    "chrome-devtools": { "type": "stdio", "command": "npx", "args": ["chrome-devtools-mcp@latest"] },
    "shadcn": { "type": "stdio", "command": "npx", "args": ["-y", "shadcn@latest", "mcp"] },
    "perplexity": { "type": "http", "url": "https://api.perplexity.ai/mcp" },
    "perplexity-computer": { "type": "http", "url": "https://www.perplexity.ai/rest/computer/mcp" },
    "stitch": { "type": "http", "url": "https://stitch.googleapis.com/mcp", "headers": { "X-Goog-Api-Key": "${STITCH_API_KEY}" } },
    "21st": { "type": "http", "url": "https://21st.dev/api/mcp", "headers": { "x-api-key": "${TWENTYFIRST_API_KEY}" } },
    "context7": { "type": "http", "url": "https://mcp.context7.com/mcp", "headers": { "Authorization": "Bearer ${CONTEXT7_API_KEY}" } }
  }
}
